{
  "appId": "com.scfrederick.moke-meta-hackathon",
  "productName": "moke-meta-hackathon",
  "directories": { "output": "release" },
  "files": ["build/**/*", "dist/electron/**/*", "dist/preload/**/*", "package.json"],
  "extraResources": [
    { "from": "migrations", "to": "migrations" },
    { "from": "dist/backend/app-backend", "to": "backend/app-backend" },
    { "from": "dist/backend/pdf-worker", "to": "backend/pdf-worker" },
    { "from": "dist/backend/pdf-assets", "to": "backend/pdf-assets" }
  ],
  "asar": true,
  "forceCodeSigning": false,
  "mac": {
    "target": ["dmg", "zip"],
    "identity": "-",
    "hardenedRuntime": false,
    "category": "public.app-category.productivity"
  },
  "win": { "target": ["nsis"], "signAndEditExecutable": false },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "syncDesktopName": true,
    "maintainer": "Stephen Frederick"
  },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
}
