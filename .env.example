# Local configuration only. Never place provider credentials in client variables.
APP_STAGE=development

# Meta Model API hackathon key. Meta's docs call this MODEL_API_KEY.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SEGMENTATION_MODEL=sam-3.1

# Baseten hackathon key. This exact model ID is required by the hackathon grant.
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Setup and model reference: docs/inference.md and docs/models.md.
# Cloudflare deployments also need CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN.
# Store those in your shell/profile or the matching GitHub environment secrets.
